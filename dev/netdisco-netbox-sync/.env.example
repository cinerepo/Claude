# ---------------------------------------------------------------------------
# Netdisco
# ---------------------------------------------------------------------------
NETDISCO_URL=http://netdisco:5000        # e.g. http://10.20.30.40:5000 - wherever your netdisco release is exposed
# Leave unset if no_auth=true (Netdisco deployed with authentication disabled)
# NETDISCO_USER=guest
# NETDISCO_PASS=guest

# ---------------------------------------------------------------------------
# Diode (NetBox ingestion service)
# ---------------------------------------------------------------------------
DIODE_TARGET=grpc://diode:8080/diode     # e.g. grpc://10.20.30.41:8080/diode - wherever your diode release is exposed
DIODE_CLIENT_ID=diode-ingest
DIODE_CLIENT_SECRET=changeme

# ---------------------------------------------------------------------------
# NetBox defaults (used when rules.yaml has no override for a given VLAN)
# ---------------------------------------------------------------------------
DEFAULT_SITE=Unknown
DEFAULT_ROLE=Network Device

# ---------------------------------------------------------------------------
# Device credentials (used by ORB agent / future SNMP enrichment)
# ---------------------------------------------------------------------------
DEVICE_USERNAME=admin
DEVICE_PASSWORD=CHANGEME
SNMP_COMMUNITY=public

# ---------------------------------------------------------------------------
# Discovery / Reconciliation engine
# ---------------------------------------------------------------------------
RULES_FILE=rules.yaml
STAGING_DB=data/observed_assets.db
CONSUMER_VENDORS_FILE=consumer_oui_vendors.txt

# Minimum days a device must be stable before auto-promoting (infrastructure)
# or becoming a candidate (lab/corporate)
MIN_DAYS_STABLE=7

# Decommission thresholds — override per site as needed
STALE_DAYS=30        # tag managed device as stale after N days unseen
NOTIFY_DAYS=90       # flag for review after N days unseen
DECOMMISSION_DAYS=180  # eligible for decommission after N days unseen
